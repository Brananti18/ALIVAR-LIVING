            id="globalSearch"
            type="search"
            placeholder="Cari properti, alamat, atau lokasi..."
            aria-label="Cari properti"
        >
    </label>

    <!-- Notifikasi dan akun di pojok kanan -->
    <div class="top-actions">

        <!-- Notifikasi -->
        <button
            class="icon-button"
            type="button"
            aria-label="Notifikasi"
            title="Notifikasi"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="20"
                height="20"
                aria-hidden="true"
            >
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/>
                <path d="M10 21h4"/>
            </svg>
        </button>

        <!-- Profil akun -->
        <div class="account-menu">
            <button
                class="avatar"
                id="accountMenuButton"
                type="button"
                aria-label="Buka menu akun"
                aria-expanded="false"
                aria-controls="accountDropdown"
            >
                {{ strtoupper(substr(auth()->user()->name ?? 'A', 0, 1)) }}
            </button>

            <!-- Dropdown akun -->
            <div class="account-dropdown" id="accountDropdown" hidden>
                <div class="account-info">
                    <strong>{{ auth()->user()->name }}</strong>
                    <small>{{ auth()->user()->email }}</small>
                </div>

                <div class="account-divider"></div>

                <button
                    type="button"
                    class="account-item"
                    onclick="alert('Fitur Profil Saya akan dibuat selanjutnya.')"
