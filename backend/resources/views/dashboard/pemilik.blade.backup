                    <span>♙</span> Profil Saya
                </button>

                <button
                    type="button"
                    class="account-item"
                    onclick="alert('Fitur Pengaturan Akun akan dibuat selanjutnya.')"
                >
                    <span>⚙</span> Pengaturan Akun
                </button>

                <button
                    type="button"
                    class="account-item"
                    onclick="alert('Fitur Ubah Password akan dibuat selanjutnya.')"
                >
                    <span>♧</span> Ubah Password
                </button>

                <div class="account-divider"></div>

